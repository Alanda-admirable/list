# ----------------------------------------------------
# Supabase Storage Configuration (สำหรับเก็บรูปภาพถาวร)
# ----------------------------------------------------
# 1. เข้าไปที่ https://supabase.com -> Project Settings -> API
# 2. นำ Project URL และ anon public key มาใส่ด้านล่างนี้:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (หรือใช้ SUPABASE_SERVICE_ROLE_KEY ในระดับเซิร์ฟเวอร์):
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
